{
  "name": "@macro/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Macro SDK. The ./generated layer is produced from Macro's OpenAPI specs via @hey-api/openapi-ts; hand-written SDK code lives in ./src.",
  "main": "./src/macro.ts",
  "exports": {
    ".": "./src/macro.ts",
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "sync-specs": "bun scripts/sync-specs.ts",
    "validate-webhook": "bun scripts/validate-webhook.ts",
    "coverage": "bun src/coverage/check.ts",
    "generate": "openapi-ts",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "^1.3.5",
    "hono": "^4.12.27",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "^5.9.2"
  }
}
